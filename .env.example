# LLM provider (optional — retrieval works without it, LLM only enhances answers)
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Embeddings (local, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# Server
HOST=0.0.0.0
PORT=8000

# Hybrid search (BM25 + vector fusion + cross-encoder reranking)
HYBRID_SEARCH=true
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Observability — Langfuse (optional; no-op when unset)
# Self-host: https://langfuse.com/self-hosting or use cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Async ingestion (optional — sync when unset)
# Set to enable Redis/arq queue: upload returns 202 + job_id, worker processes in background
# REDIS_URL=redis://localhost:6379
